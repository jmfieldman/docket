{
  "name": "orca-docket",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reviewer-agnostic findings resolution for coding agents, with an Orca panel.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "spec:validate": "node spec/validate.mjs",
    "check": "pnpm run typecheck && pnpm test && pnpm run spec:validate"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2"
  },
  "bin": {
    "docket": "dist/cli.js"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
