{
  "manifestVersion": 1,
  "id": "docket",
  "publisher": "jmfieldman",
  "name": "Docket",
  "version": "0.1.0",
  "description": "Review findings for the focused worktree: lanes, decisions, discussion and a serial applier.",
  "engines": { "orca": ">=1.4.0" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [{ "id": "docket", "title": "Docket", "icon": "list-checks", "entry": "panel.html" }],
    "commands": [
      { "id": "docket-open", "title": "Docket: Open for this worktree" },
      { "id": "docket-api", "title": "Docket: panel data (internal)" }
    ]
  },
  "capabilities": [{ "kind": "workspace:read" }, { "kind": "notifications:show" }]
}
