{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmfieldman/orca-docket/spec/schema/unit.schema.json",
  "title": "Docket unit",
  "description": "One docket per git worktree. Stored at $(git rev-parse --git-dir)/docket/unit.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repo", "branch", "worktreePath", "firstSeenHead", "nextFindingNumber", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteUrl"],
      "properties": {
        "remoteUrl": { "type": "string" },
        "owner": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "branch": { "type": "string", "minLength": 1 },
    "worktreePath": { "type": "string", "minLength": 1 },
    "firstSeenHead": { "$ref": "common.schema.json#/$defs/sha" },
    "pr": {
      "description": "Null until a PR exists for the branch.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "url"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "url": { "type": "string" }
          }
        }
      ]
    },
    "lastIngest": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "head"],
          "properties": {
            "at": { "$ref": "common.schema.json#/$defs/timestamp" },
            "head": { "$ref": "common.schema.json#/$defs/sha" }
          }
        }
      ]
    },
    "lastViewedAt": {
      "description": "When the user last viewed the docket. Findings created after it show as new.",
      "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/timestamp" }]
    },
    "applier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["idle", "running"] },
        "terminalHandle": { "type": "string" },
        "since": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "nextFindingNumber": { "type": "integer", "minimum": 1 },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
