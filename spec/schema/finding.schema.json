{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmfieldman/docket/spec/schema/finding.schema.json",
  "title": "Docket finding",
  "description": "One finding. Stored at docket/findings/<id>.json. Each finding moves through its states independently of every other finding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "rev", "state", "title", "summary", "sources", "detectedAtCommit", "iterations", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/findingId" },
    "rev": { "type": "integer", "minimum": 0, "description": "Incremented on every write. Writers pass the rev they read; the CLI rejects a mismatch." },
    "state": { "$ref": "common.schema.json#/$defs/state" },
    "stale": {
      "description": "Set when the code or the source text under an open finding changed. Not a state.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "since", "sinceCommit"],
          "properties": {
            "reason": { "type": "string" },
            "since": { "$ref": "common.schema.json#/$defs/timestamp" },
            "sinceCommit": { "$ref": "common.schema.json#/$defs/sha" }
          }
        }
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "description": "The issue in two or three neutral sentences." },
    "explanation": { "type": "string", "description": "Markdown. Background for a reader who does not know this code." },
    "severityRationale": { "type": "string", "description": "Why the issue matters, and how much." },
    "category": { "$ref": "common.schema.json#/$defs/category" },
    "reviewerSeverity": {
      "enum": ["critical", "high", "medium", "low", "nit", "unknown"],
      "description": "The severity the reviewer claimed. research.assessedSeverity holds docket's own assessment."
    },
    "location": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/location" }]
    },
    "detectedAtCommit": { "$ref": "common.schema.json#/$defs/sha" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Every source that raised this finding. More than one entry means reviewers reported the same issue.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "excerpt"],
        "properties": {
          "sourceId": { "$ref": "common.schema.json#/$defs/sourceId" },
          "excerpt": { "type": "string", "description": "The reviewer's text for this finding, verbatim." },
          "ordinal": { "type": "integer", "minimum": 0, "description": "Position of this finding inside a multi-finding source." }
        }
      }
    },
    "research": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/research" }]
    },
    "triage": {
      "description": "Where the finding sits on the two axes. Written with research; rewritten when discussion changes the options. Required when research is not null.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/triage" }]
    },
    "discussion": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/discussion" }]
    },
    "iterations": {
      "type": "array",
      "description": "One entry per decision, oldest first.",
      "items": { "$ref": "#/$defs/iteration" }
    },
    "resolution": {
      "description": "Set when the finding closes. Cleared on reopen; the history stays in iterations and events.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/resolution" }]
    },
    "reply": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reply" }]
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complexity", "complexityReason", "confidence", "confidenceReason", "lane", "assessedAt", "assessedAtCommit"],
      "properties": {
        "complexity": {
          "type": "integer", "minimum": 1, "maximum": 4,
          "description": "Of the recommended option. 1 trivial, 2 modest, 3 involved, 4 major."
        },
        "complexityReason": { "type": "string", "minLength": 1, "maxLength": 140 },
        "confidence": {
          "type": "integer", "minimum": 1, "maximum": 4,
          "description": "In the recommended option. 1 unclear, 2 split, 3 likely, 4 certain."
        },
        "confidenceReason": { "type": "string", "minLength": 1, "maxLength": 140 },
        "lane": {
          "enum": ["quick", "decide", "scope", "dig"],
          "description": "Derived: complexity <= 2 and confidence >= 3 → quick; complexity <= 2 and confidence <= 2 → decide; complexity >= 3 and confidence >= 3 → scope; otherwise dig. The CLI computes it."
        },
        "assessedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "assessedAtCommit": { "$ref": "common.schema.json#/$defs/sha" }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "confidence", "analysis", "options", "recommendedOptionId", "researchedAt", "researchedAtCommit"],
      "properties": {
        "verdict": { "enum": ["valid", "partially_valid", "not_valid", "unclear"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "assessedSeverity": { "$ref": "common.schema.json#/$defs/severity" },
        "analysis": { "type": "string", "description": "Markdown. Why the verdict holds, with references to the code." },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "note"],
            "properties": {
              "path": { "type": "string" },
              "symbol": { "type": "string" },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/option" }
        },
        "recommendedOptionId": { "type": "string", "pattern": "^[A-F]$" },
        "researchedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "researchedAtCommit": { "$ref": "common.schema.json#/$defs/sha" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "description", "pros", "cons", "effort", "blastRadius"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-F]$" },
        "kind": { "$ref": "common.schema.json#/$defs/optionKind" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "description": "Markdown. What the applier will change, or why no change is needed now." },
        "pros": { "type": "array", "items": { "type": "string" } },
        "cons": { "type": "array", "items": { "type": "string" } },
        "effort": { "enum": ["trivial", "small", "medium", "large"] },
        "blastRadius": { "$ref": "common.schema.json#/$defs/blastRadius" }
      }
    },
    "discussion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "entries"],
      "properties": {
        "sessionId": { "type": "string", "description": "Agent session ID, so the user can continue later." },
        "startedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "lastActiveAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "head", "question", "answer"],
            "properties": {
              "at": { "$ref": "common.schema.json#/$defs/timestamp" },
              "head": { "$ref": "common.schema.json#/$defs/sha" },
              "question": { "type": "string", "description": "The user's question, condensed." },
              "answer": { "type": "string", "description": "The agent's answer, condensed. Markdown." },
              "optionsChanged": { "type": "boolean" }
            }
          }
        }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "origin", "decision", "decidedAt", "decidedAtCommit", "outcome"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "origin": {
          "enum": ["panel", "quick", "session"],
          "description": "panel: decided in the Docket pane or the web view. quick: quick fix or bulk accept. session: recorded by an ad-hoc agent session (the pane shows it as inferred)."
        },
        "decision": { "$ref": "#/$defs/decision" },
        "decidedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "decidedAtCommit": { "$ref": "common.schema.json#/$defs/sha" },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "queuedAt"],
          "properties": {
            "position": { "type": "integer", "minimum": 1 },
            "queuedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
          }
        },
        "startedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha", "message"],
            "properties": {
              "sha": { "$ref": "common.schema.json#/$defs/sha" },
              "message": { "type": "string" }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checks"],
          "properties": {
            "status": { "enum": ["passed", "failed", "skipped"] },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "result"],
                "properties": {
                  "name": { "type": "string", "description": "A test command, or 'concern re-check'." },
                  "result": { "enum": ["passed", "failed", "skipped"] },
                  "detail": { "type": "string" }
                }
              }
            },
            "notes": { "type": "string" }
          }
        },
        "alsoResolves": {
          "type": "array",
          "description": "Other findings this iteration's fix closes.",
          "items": { "$ref": "common.schema.json#/$defs/findingId" },
          "uniqueItems": true
        },
        "outcome": {
          "enum": ["pending", "queued", "fixing", "completed", "needs_attention", "abandoned", "acknowledged", "deferred"],
          "description": "pending: decided but not queued. abandoned: replaced by a later iteration before it finished."
        },
        "bounceReason": { "type": "string", "description": "Why the applier set needs_attention." },
        "summary": { "type": "string", "description": "One line: what this iteration did." },
        "endedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "kind"],
      "properties": {
        "optionId": {
          "type": "string",
          "pattern": "^([A-F]|custom)$",
          "description": "custom means the user wrote the decision in instruction."
        },
        "kind": { "$ref": "common.schema.json#/$defs/optionKind" },
        "instruction": { "type": "string", "description": "Extra direction for the applier, the custom fix, or the reason." }
      },
      "allOf": [
        {
          "if": { "required": ["optionId"], "properties": { "optionId": { "const": "custom" } } },
          "then": { "required": ["instruction"], "properties": { "instruction": true } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "enum": ["acknowledge", "defer"] } } },
          "then": { "required": ["instruction"], "properties": { "instruction": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "summary", "closedAt", "closedAtCommit"],
      "properties": {
        "outcome": { "$ref": "common.schema.json#/$defs/closedOutcome" },
        "summary": { "type": "string", "minLength": 1, "description": "One line. Shown on collapsed closed findings." },
        "reason": { "type": "string", "description": "Required for acknowledged and deferred." },
        "closedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "closedAtCommit": { "$ref": "common.schema.json#/$defs/sha" },
        "resolvedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["findingId", "iteration"],
          "description": "Set when another finding's fix closed this one.",
          "properties": {
            "findingId": { "$ref": "common.schema.json#/$defs/findingId" },
            "iteration": { "type": "integer", "minimum": 1 }
          }
        },
        "deferral": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/deferralId" },
            "path": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["outcome"], "properties": { "outcome": { "enum": ["acknowledged", "deferred"] } } },
          "then": { "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "required": ["outcome"], "properties": { "outcome": { "const": "deferred" } } },
          "then": { "required": ["deferral"], "properties": { "deferral": true } }
        }
      ]
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["none", "drafted", "approved", "posted", "skipped"] },
        "draft": { "type": "string" },
        "targetSourceId": { "$ref": "common.schema.json#/$defs/sourceId" },
        "resolveThread": { "type": "boolean", "description": "Resolve the GitHub thread when the reply posts." },
        "postedUrl": { "type": "string" },
        "postedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
